{
  "name": "companycompare",
  "version": "0.1.0",
  "private": true,
  "description": "SaaS de análisis competitivo asistido por IA para empresarios",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "if [ -n \"$DATABASE_URL\" ]; then prisma migrate deploy; fi && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@prisma/client": "^6.14.0",
    "bcryptjs": "^3.0.2",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "16.3.5",
    "prisma": "^6.14.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2"
  }
}
