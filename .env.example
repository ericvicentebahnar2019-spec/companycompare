# ─────────────────────────────────────────────────────────────
# CompanyCompare — variables de entorno
# Copia este fichero a .env.local y rellena los valores.
# NINGUNA de estas variables se expone al navegador.
# ─────────────────────────────────────────────────────────────

# Secreto para firmar las cookies de sesión (obligatorio en producción).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Base de datos PostgreSQL.
# Si se deja VACÍA, la aplicación arranca en MODO DEMO con un almacén en
# memoria sembrado con datos ficticios (NovaTech vs AlphaTech). Útil para
# probar el producto sin infraestructura; los datos se pierden al reiniciar.
DATABASE_URL=

# Conexión DIRECTA, sin pooler. Solo la usan las migraciones, que necesitan
# una sesión estable. En Neon y en Vercel Postgres la crea la integración por
# su cuenta. Si tu proveedor no distingue conexión agrupada de directa, pon
# aquí el mismo valor que en DATABASE_URL.
DATABASE_URL_UNPOOLED=

# ── Envío de correo ──────────────────────────────────────────
# Necesario para que funcione la recuperación de contraseña. Sin estas dos
# variables, en producción el formulario lo dice en lugar de dejar al usuario
# esperando un correo que no va a llegar.
RESEND_API_KEY=
EMAIL_FROM=

# URL pública, para construir los enlaces que se envían por correo.
# En Vercel se deduce sola; indícala solo en otro alojamiento.
APP_URL=

# ── Proveedor de IA ──────────────────────────────────────────
# Proveedor activo para la capa /services/ai: "mock" | "anthropic"
# "mock" (por defecto) usa el motor de análisis determinista local y no
# realiza ninguna llamada de red. Es lo que alimenta la demo.
AI_PROVIDER=mock

# Solo necesario si AI_PROVIDER=anthropic. Se lee únicamente en el servidor.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ── Enriquecimiento desde URL pública (fase futura) ──────────
# Deja en "off" mientras no haya proveedor de scraping/enriquecimiento.
# Cuando se active, los datos recogidos se etiquetan como "dato público"
# y nunca se mezclan con los datos introducidos por el usuario.
ENRICHMENT_PROVIDER=off
